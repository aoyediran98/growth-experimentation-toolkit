ANTHROPIC_API_KEY=
# Set automatically when you add "Upstash for Redis" from the Vercel Marketplace to this project:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: Vercel Blob for ideation image uploads (without it, images up to ~500KB are kept in Redis)
BLOB_READ_WRITE_TOKEN=
# Stakeholder reviews (Variants tab). A secret only you know; the panel asks for it before fetching, building or publishing.
REVIEW_SHARE_TOKEN=
# Reviews are stored in your Vercel Blob store (BLOB_READ_WRITE_TOKEN above) and served at /r/<id>, or in your own here.now account:
HERENOW_KEY=
HERENOW_ACCOUNT=
