{
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/review.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "lib/review-template/**"
    }
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/ideation/s/:id",
      "destination": "/ideation/"
    },
    {
      "source": "/r/:id",
      "destination": "/api/r?id=:id"
    }
  ]
}
